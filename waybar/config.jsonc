{
    "layer": "top",
    "position": "bottom",
    "height": 34,
    "spacing": 4,

    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["hyprland/window"],
    "modules-right": ["mpris", "custom/protonvpn", "custom/khal", "pulseaudio", "network", "clock", "tray"],

    "hyprland/workspaces": {
        "format": "[{id}: {windows}]",
        "format-window-separator": ", ",
        "window-rewrite": {
            "class<.*>": "{class}"
        },
        "window-rewrite-default": "?",
        "on-click": "activate",
        "all-outputs": true
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 50
    },

    "mpris": {
        "format": "{player_icon} {dynamic}",
        "format-paused": "{status_icon} {dynamic}",
        "player-icons": {
            "spotify": "",
            "default": ""
        },
        "status-icons": {
            "paused": ""
        },
        "max-length": 40,
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous"
    },

    "clock": {
        "format": "{:%H:%M   %a %d %b}",
        "tooltip-format": "{:%Y-%m-%d | %H:%M}"
    },

    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-muted": "muted",
        "format-icons": {
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },

    "network": {
        "format-wifi": "{essid} ({signalStrength}%)",
        "format-ethernet": "eth",
        "format-disconnected": "disconnected",
        "tooltip-format": "{ifname}: {ipaddr}"
    },

    "tray": {
        "spacing": 10
    },

    "custom/protonvpn": {
        "exec": "~/.config/waybar/scripts/protonvpn.sh",
        "return-type": "json",
        "interval": 15,
        "on-click": "~/.config/waybar/scripts/protonvpn.sh --toggle",
        "signal": 8
    },

    "custom/khal": {
        "exec": "~/.config/waybar/scripts/khal.sh",
        "return-type": "json",
        "interval": 300,
        "on-click": "alacritty -e ikhal",
        "max-length": 40
    }
}
